{
  "manifest_version": 3,
  "name": "Sideveil — Temporary AI Chats",
  "short_name": "Sideveil",
  "version": "1.1.0",
  "description": "Make temporary chats the default in ChatGPT, Claude, and Gemini. Choose which services to automate.",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "permissions": ["storage", "activeTab"],
  "action": {"default_title": "Sideveil settings", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
    "js": ["core.js", "content.js"],
    "run_at": "document_start"
  }]
}
